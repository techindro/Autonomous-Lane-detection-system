   "source": [
    "# Data Science Pinnacle - Lane Detection Project\n",
    "## Notebook 01: Data Exploration and Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import cv2\n",
    "import matplotlib.pyplot as plt
    "import seaborn as sns\n",
    "from pathlib import Path\n",
    "import json"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuration\n",
    "DATA_PATH = \"../data/raw/tusimple_sample/\"\n",
    "OUTPUT_PATH = \"../outputs/exploration/\"\n",
    "Path(OUTPUT_PATH).mkdir(parents=True, exist_ok=True)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 1. Load and explore dataset\n",
    "print(\"Dataset Structure:\")\n",
    "for path in Path(DATA_PATH).rglob(\"*\"):\n",
    "    if path.is_file():\n",
    "        print(f\"  {path.relative_to(DATA_PATH)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 2. Analyze image statistics\n",
    "def analyze_images(image_paths):\n",
    "    heights, widths, channels = [], [], []\n",
    "    for img_path in image_paths[:100]:  # Sample 100 images\n",
    "        img = cv2.imread(str(img_path))\n",
    "        if img is not None:\n",
    "            h, w, c = img.shape\n",
    "            heights.append(h)\n",
    "            widths.append(w)\n",
    "            channels.append(c)\n",
    "    return heights, widths, channels"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# 3. Visualize sample images\n",
    "def visualize_samples(image_paths, n_samples=5):\n",
    "    fig, axes = plt.subplots(1, n_samples, figsize=(20, 4))\n",
    "    for idx, img_path in enumerate(image_paths[:n_samples]):\n",
    "        img = cv2.imread(str(img_path))\n",
    "        img_rgb = cv2.cvtColor(img, cv2.COLOR_BGR2RGB)\n",
    "        axes[idx].imshow(img_rgb)\n",
    "        axes[idx].set_title(f\"Sample {idx+1}\")\n",
    "        axes[idx].axis('off')\n",
    "    plt.tight_layout()\n",
    "    plt.savefig(f\"{OUTPUT_PATH}/sample_images.png\", dpi=300)\n",
    "    plt.show()"
   ]
  }
 ],
